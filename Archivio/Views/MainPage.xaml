<?xml version="1.0" encoding="UTF-8" ?>
<Page
    x:Name="RootPage"
    x:Class="Archivio.Views.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls"
    xmlns:primitives="using:CommunityToolkit.WinUI.UI.Controls.Primitives"
    xmlns:models="using:Archivio.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="FilteringColumnHeaderStyle" TargetType="primitives:DataGridColumnHeader">
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <Grid ColumnDefinitions="*, Auto">
                            <TextBlock Text="{Binding}" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Background="Transparent" BorderThickness="0" Margin="4,0,0,0" Padding="2"
                                    PointerPressed="FilterButton_PointerPressed">
                                <FontIcon Glyph="&#xE71C;" FontSize="11"/>
                                <Button.Flyout>
                                    <Flyout Opening="FilterFlyout_Opening">
                                        <StackPanel Width="220" Spacing="8">
                                            <TextBlock Text="表示する項目を選択:" FontWeight="SemiBold" />
                                            <TextBox x:Name="SearchValuesTextBox" PlaceholderText="選択肢を検索..." TextChanged="SearchValuesTextBox_TextChanged" />
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Button Content="すべて選択" Click="SelectAllValues_Click" Width="100"/>
                                                <Button Content="すべて解除" Click="ClearAllValues_Click" Width="100"/>
                                            </StackPanel>
                                            <ScrollViewer MaxHeight="180">
                                                <ItemsControl x:Name="ValuesItemsControl">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <CheckBox Content="{Binding Value}" IsChecked="{Binding IsChecked, Mode=TwoWay}" Margin="0,2" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                            <Grid ColumnDefinitions="*, *">
                                                <Button Content="適用" Click="ApplyFilter_Click" HorizontalAlignment="Stretch" Margin="0,0,4,0"/>
                                                <Button Grid.Column="1" Content="クリア" Click="ClearFilter_Click" HorizontalAlignment="Stretch" Margin="4,0,0,0"/>
                                            </Grid>
                                        </StackPanel>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                        </Grid>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Padding="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition x:Name="FileListRow" Height="1*" MinHeight="100" />
            <RowDefinition Height="8" /> <!-- For GridSplitter spacing -->
            <RowDefinition x:Name="DetailsRow" Height="2*" MinHeight="150" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto">
            <StackPanel
                Grid.Column="0"
                Orientation="Horizontal"
                Spacing="8">
                <Button
                    x:Name="ChooseFolderButton"
                    Click="ChooseFolderButton_Click"
                    Content="フォルダを選択" />
                <Button
                    x:Name="RefreshButton"
                    Click="RefreshButton_Click"
                    Content="再読み込み" />
                <ToggleSwitch
                    x:Name="SubfoldersToggle"
                    AutomationProperties.Name="サブフォルダーも検索"
                    IsOn="{x:Bind ViewModel.IncludeSubfolders, Mode=TwoWay}"
                    ToolTipService.ToolTip="サブフォルダーも検索"
                    OnContent=""
                    OffContent="" />
                <TextBox
                    Width="420"
                    PlaceholderText="タイトル、出演者、ファイル名などを検索"
                    Text="{x:Bind ViewModel.FilterText, Mode=TwoWay}"
                    TextChanged="FilterTextBox_TextChanged"
                    ToolTipService.ToolTip="タイトル、出演者、ファイル名などから動画を検索" />
                <Button
                    x:Name="ExportCsvButton"
                    Click="ExportCsvButton_Click"
                    Content="一覧をCSV保存"
                    IsEnabled="{x:Bind ViewModel.CanExportCsv, Mode=OneWay}" />
                <Button
                    x:Name="CancelRefreshButton"
                    Click="CancelRefreshButton_Click"
                    Content="中止"
                    IsEnabled="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
            </StackPanel>

            <Border
                Grid.Column="1"
                Margin="12,0,0,0"
                Padding="8,4"
                CornerRadius="4"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                Visibility="{x:Bind ViewModel.StatusMessageVisibility, Mode=OneWay}">
                <TextBlock
                    MaxWidth="420"
                    Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                    TextWrapping="WrapWholeWords" />
                </Border>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                <ToggleButton
                    x:Name="DetailViewToggleButton"
                    IsChecked="{x:Bind ViewModel.IsDetailView, Mode=OneWay}"
                    Click="DetailViewToggleButton_Click"
                    Content="詳細" />
                <ToggleButton
                    x:Name="ThumbnailViewToggleButton"
                    IsChecked="{x:Bind ViewModel.IsThumbnailView, Mode=OneWay}"
                    Click="ThumbnailViewToggleButton_Click"
                    Content="タイル" />
                <ComboBox
                    x:Name="ThumbnailTileSizeComboBox"
                    Width="100"
                    SelectedIndex="{x:Bind ViewModel.ThumbnailTileSizeIndex, Mode=TwoWay}"
                    ToolTipService.ToolTip="タイルサイズ">
                    <ComboBoxItem Content="小" />
                    <ComboBoxItem Content="標準" />
                    <ComboBoxItem Content="大" />
                    <ComboBoxItem Content="特大" />
                </ComboBox>
            </StackPanel>
        </Grid>

        <!-- Row 1: Video File List -->
        <Grid Grid.Row="1" Margin="0,12,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            
            <TextBlock
                x:Name="VideoListHeader"
                Grid.Row="0"
                Margin="0,0,0,8"
                FontSize="18"
                FontWeight="SemiBold"
                Text="動画一覧" />

            <Border
                Grid.Row="1"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="4">
                <Grid>
                    <controls:DataGrid
                    x:Name="VideoListDataGrid"
                    AutoGenerateColumns="False"
                    CanUserResizeColumns="True"
                    CanUserSortColumns="True"
                    CanUserReorderColumns="True"
                    IsReadOnly="True"
                    ItemsSource="{x:Bind ViewModel.Videos, Mode=OneWay}"
                    SelectedItem="{x:Bind ViewModel.SelectedVideo, Mode=TwoWay}"
                    SelectionMode="Single"
                    DoubleTapped="DataGrid_DoubleTapped"
                    ContextRequested="VideoListDataGrid_ContextRequested"
                    Sorting="VideoListDataGrid_Sorting"
                    Visibility="{x:Bind ViewModel.DetailViewVisibility, Mode=OneWay}">
                    <controls:DataGrid.ContextFlyout>
                        <MenuFlyout>
                            <MenuFlyoutItem x:Name="RenameMenuItem" Text="ファイル名の変更" Click="RenameMenuItem_Click" />
                            <MenuFlyoutItem x:Name="DeleteMenuItem" Text="ファイルの削除" Click="DeleteMenuItem_Click" />
                            <MenuFlyoutItem x:Name="ReMuxMenuItem" Text="Ffmpegでの再MUX" Click="ReMuxMenuItem_Click" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem x:Name="ClearCacheMenuItem" Text="キャッシュをクリア" Click="ClearCacheMenuItem_Click" />
                            <MenuFlyoutSubItem x:Name="LanguageMenu" Text="表示言語 / Language" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem x:Name="ReadmeMenuItem" Text="READMEを表示" Click="ReadmeMenuItem_Click" />
                            <MenuFlyoutItem x:Name="AboutMenuItem" Text="Archivioについて" Click="AboutMenuItem_Click" />
                        </MenuFlyout>
                    </controls:DataGrid.ContextFlyout>
                    <controls:DataGrid.Columns>
                        <controls:DataGridTextColumn Binding="{Binding StatusText}" Header="状態" IsReadOnly="True" Width="80" Tag="StatusText" />
                        <controls:DataGridTextColumn Binding="{Binding FileName, Mode=TwoWay}" Header="ファイル名" IsReadOnly="True" Width="220" Tag="FileName" HeaderStyle="{StaticResource FilteringColumnHeaderStyle}" />
                        <controls:DataGridTextColumn Binding="{Binding FileSizeText}" Header="サイズ" IsReadOnly="True" Width="90" Tag="FileSizeText" HeaderStyle="{StaticResource FilteringColumnHeaderStyle}" />
                        <controls:DataGridTextColumn Binding="{Binding Title}" Header="タイトル" IsReadOnly="True" Width="180" Tag="Title" HeaderStyle="{StaticResource FilteringColumnHeaderStyle}" />
                        <controls:DataGridTextColumn Binding="{Binding Participants}" Header="出演者" IsReadOnly="True" Width="180" Tag="Participants" HeaderStyle="{StaticResource FilteringColumnHeaderStyle}" />
                        <controls:DataGridTextColumn Binding="{Binding ReleaseDateText}" Header="発売日" IsReadOnly="True" Width="120" Tag="ReleaseDateText" HeaderStyle="{StaticResource FilteringColumnHeaderStyle}" />
                        <controls:DataGridTextColumn Binding="{Binding CatalogNumber}" Header="品番" IsReadOnly="True" Width="140" Tag="CatalogNumber" HeaderStyle="{StaticResource FilteringColumnHeaderStyle}" />
                        <controls:DataGridTextColumn Binding="{Binding RatingStarsText}" Header="評価" IsReadOnly="True" Width="120" Tag="Rating" HeaderStyle="{StaticResource FilteringColumnHeaderStyle}" />
                        <controls:DataGridTextColumn Binding="{Binding Publisher}" Header="発行元" IsReadOnly="True" Width="140" Tag="Publisher" HeaderStyle="{StaticResource FilteringColumnHeaderStyle}" />
                        <controls:DataGridTextColumn Binding="{Binding ContentDistributor}" Header="レーベル" IsReadOnly="True" Width="140" Tag="ContentDistributor" HeaderStyle="{StaticResource FilteringColumnHeaderStyle}" />
                        <controls:DataGridTextColumn Binding="{Binding Category}" Header="カテゴリ" IsReadOnly="True" Width="120" Tag="Category" HeaderStyle="{StaticResource FilteringColumnHeaderStyle}" />
                        <controls:DataGridTextColumn Binding="{Binding Comment}" Header="コメント" IsReadOnly="True" Width="220" Tag="Comment" HeaderStyle="{StaticResource FilteringColumnHeaderStyle}" />
                        <controls:DataGridTextColumn Binding="{Binding Duration}" Header="再生時間" IsReadOnly="True" Width="100" Tag="Duration" HeaderStyle="{StaticResource FilteringColumnHeaderStyle}" />
                        <controls:DataGridTextColumn Binding="{Binding FrameWidth}" Header="フレーム幅" IsReadOnly="True" Width="90" Tag="FrameWidth" HeaderStyle="{StaticResource FilteringColumnHeaderStyle}" />
                        <controls:DataGridTextColumn Binding="{Binding FrameHeight}" Header="フレーム高さ" IsReadOnly="True" Width="90" Tag="FrameHeight" HeaderStyle="{StaticResource FilteringColumnHeaderStyle}" />
                        <controls:DataGridTextColumn Binding="{Binding FrameRate}" Header="フレームレート" IsReadOnly="True" Width="90" Tag="FrameRate" HeaderStyle="{StaticResource FilteringColumnHeaderStyle}" />
                        <controls:DataGridTextColumn Binding="{Binding VideoBitrate}" Header="映像ビットレート" IsReadOnly="True" Width="110" Tag="VideoBitrate" HeaderStyle="{StaticResource FilteringColumnHeaderStyle}" />
                        <controls:DataGridTextColumn Binding="{Binding VideoCompression}" Header="圧縮方式" IsReadOnly="True" Width="120" Tag="VideoCompression" HeaderStyle="{StaticResource FilteringColumnHeaderStyle}" />
                        <controls:DataGridTextColumn Binding="{Binding AudioSampleRate}" Header="サンプルレート" IsReadOnly="True" Width="110" Tag="AudioSampleRate" HeaderStyle="{StaticResource FilteringColumnHeaderStyle}" />
                        <controls:DataGridTextColumn Binding="{Binding AudioBitrate}" Header="音声ビットレート" IsReadOnly="True" Width="110" Tag="AudioBitrate" HeaderStyle="{StaticResource FilteringColumnHeaderStyle}" />
                        <controls:DataGridTextColumn Binding="{Binding AudioFormat}" Header="音声形式" IsReadOnly="True" Width="110" Tag="AudioFormat" HeaderStyle="{StaticResource FilteringColumnHeaderStyle}" />
                    </controls:DataGrid.Columns>
                    </controls:DataGrid>

                <GridView
                    x:Name="VideoThumbnailGridView"
                    ItemsSource="{x:Bind ViewModel.Videos, Mode=OneWay}"
                    SelectedItem="{x:Bind ViewModel.SelectedVideo, Mode=TwoWay}"
                    SelectionMode="Single"
                    IsItemClickEnabled="False"
                    IsSwipeEnabled="False"
                    DoubleTapped="DataGrid_DoubleTapped"
                    ContextRequested="VideoThumbnailGridView_ContextRequested"
                    IsTabStop="True"
                    AutomationProperties.Name="動画一覧（サムネイル）"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                    Visibility="{x:Bind ViewModel.ThumbnailViewVisibility, Mode=OneWay}">
                    <GridView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsWrapGrid Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </GridView.ItemsPanel>
                    <GridView.ItemTemplate>
                        <DataTemplate x:DataType="models:VideoFileItem">
                            <Grid
                                Width="{Binding DataContext.ThumbnailTileWidth, ElementName=RootPage}"
                                Margin="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="{Binding DataContext.ThumbnailImageRowHeight, ElementName=RootPage}" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4">
                                    <Grid>
                                        <Image Source="{Binding ThumbnailImage}" Stretch="Uniform" />
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="4" Visibility="{Binding ThumbnailLoadingVisibility}">
                                            <ProgressRing IsActive="True" Width="36" Height="36" />
                                            <TextBlock Text="読み込み中..." Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="4" Visibility="{Binding ThumbnailEmptyVisibility}">
                                            <FontIcon Glyph="&#xEB9F;" FontSize="36" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Text="カバーアートなし" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="4" Visibility="{Binding ThumbnailErrorVisibility}">
                                            <FontIcon Glyph="&#xE783;" FontSize="36" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Text="読み込み失敗" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <TextBlock Grid.Row="1" Margin="2,8,2,0" Text="{Binding DisplayTitle}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" />
                                <TextBlock Grid.Row="2" Margin="2,2,2,0" Text="{Binding DisplayParticipants}" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Grid>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                    </GridView>
                </Grid>
            </Border>
        </Grid>

        <!-- Horizontal GridSplitter between File List and Details Area -->
        <controls:GridSplitter
            Grid.Row="2"
            Height="8"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Center"
            ResizeBehavior="PreviousAndNext"
            ResizeDirection="Rows"
            Background="Transparent">
            <controls:GridSplitter.Element>
                <Grid HorizontalAlignment="Stretch" VerticalAlignment="Center" Height="2" Background="{ThemeResource CardStrokeColorDefaultBrush}" />
            </controls:GridSplitter.Element>
        </controls:GridSplitter>

        <!-- Row 3: Details Area -->
        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock
                x:Name="DetailsHeader"
                Grid.Row="0"
                Margin="0,0,0,8"
                FontSize="18"
                FontWeight="SemiBold"
                Text="詳細情報" />

            <Grid Grid.Row="1" Visibility="{x:Bind ViewModel.DetailedPanelVisibility, Mode=OneWay}">
                <Grid.ColumnDefinitions>
                    <!-- Left: Large Cover Art Area (6*) -->
                    <ColumnDefinition x:Name="CoverArtColumn" Width="6*" MinWidth="200" />
                    <ColumnDefinition Width="12" /> <!-- For GridSplitter -->
                    <!-- Middle: Editable properties panel (5*) -->
                    <ColumnDefinition x:Name="PropertiesColumn" Width="5*" MinWidth="200" />
                    <ColumnDefinition Width="12" /> <!-- For GridSplitter -->
                    <!-- Right: Read-only technical properties panel (4*) -->
                    <ColumnDefinition x:Name="TechnicalColumn" Width="4*" MinWidth="200" />
                </Grid.ColumnDefinitions>

                <!-- Left Panel: Cover Art FlipView and its associated edit toolbar -->
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border
                        Grid.Row="0"
                        DoubleTapped="CoverArt_DoubleTapped"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="4">
                        <Grid>
                            <Grid x:Name="CoverArtContent">
                            <FlipView
                                x:Name="CoverArtFlipView"
                                ItemsSource="{x:Bind ViewModel.SelectedVideo.CoverArts, Mode=OneWay}"
                                SelectedIndex="{x:Bind ViewModel.SelectedVideo.SelectedCoverArtIndex, Mode=OneWay}"
                                SelectionChanged="CoverArtFlipView_SelectionChanged"
                                Visibility="{x:Bind ViewModel.SelectedVideo.CoverArtVisibility, Mode=OneWay}">
                                <FlipView.ItemTemplate>
                                    <DataTemplate x:DataType="ImageSource">
                                        <Image
                                            Stretch="Uniform"
                                            Source="{Binding}" />
                                    </DataTemplate>
                                </FlipView.ItemTemplate>
                            </FlipView>

                            <!-- Placeholder when no cover art is loaded -->
                            <StackPanel
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="8"
                                Visibility="{x:Bind ViewModel.SelectedVideo.PlaceholderVisibility, Mode=OneWay}">
                                <FontIcon Glyph="&#xEB9F;" FontSize="48" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock
                                    x:Name="NoCoverArtText"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="カバーアートはありません" />
                            </StackPanel>
                            </Grid>

                            <Grid
                                x:Name="VideoPlaybackContent"
                                Visibility="Collapsed" />
                        </Grid>
                    </Border>

                    <!-- Image edit toolbar aligned beneath the image frame -->
                    <StackPanel
                        Grid.Row="1"
                        Margin="0,8,0,0"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Spacing="12">
                        <ToggleButton
                            x:Name="VideoPlaybackToggleButton"
                            Content="再生"
                            IsChecked="False"
                            Click="VideoPlaybackToggleButton_Click" />
                        <ToggleButton
                            x:Name="CoverArtViewToggleButton"
                            Content="画像"
                            IsChecked="True"
                            Click="CoverArtViewToggleButton_Click" />
                        <Button
                            x:Name="AddImageButton"
                            Content="画像追加"
                            Click="AddImageButton_Click"
                            IsEnabled="{x:Bind ViewModel.IsVideoSelected, Mode=OneWay}" />
                        <Button
                            x:Name="ReplaceImageButton"
                            Content="画像変更"
                            Click="ReplaceImageButton_Click"
                            IsEnabled="{x:Bind ViewModel.SelectedVideo.IsImageControlsEnabled, Mode=OneWay}" />
                        <Button
                            x:Name="DeleteImageButton"
                            Content="画像削除"
                            Click="DeleteImageButton_Click"
                            IsEnabled="{x:Bind ViewModel.SelectedVideo.IsImageControlsEnabled, Mode=OneWay}" />
                        <Button
                            x:Name="SaveImageButton"
                            Content="画像保存"
                            Click="SaveImageButton_Click"
                            IsEnabled="{x:Bind ViewModel.SelectedVideo.HasCoverArtChangesNotify, Mode=OneWay}" />
                    </StackPanel>
                </Grid>

                <!-- Vertical GridSplitter between Cover Art and Properties Panel -->
                <controls:GridSplitter
                    Grid.Column="1"
                    Width="12"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Stretch"
                    ResizeBehavior="PreviousAndNext"
                    ResizeDirection="Columns"
                    Background="Transparent">
                    <controls:GridSplitter.Element>
                        <Grid HorizontalAlignment="Center" VerticalAlignment="Stretch" Width="2" Background="{ThemeResource CardStrokeColorDefaultBrush}" />
                    </controls:GridSplitter.Element>
                </controls:GridSplitter>

                <!-- Right Panel: Scrollable Editable Properties -->
                <ScrollViewer Grid.Column="2">
                    <StackPanel Spacing="12" Padding="0,0,12,0">
                        <TextBox
                            x:Name="TitleTextBox"
                            Header="タイトル"
                            Text="{x:Bind ViewModel.SelectedVideo.Title, Mode=TwoWay}" />
                        <TextBox
                            x:Name="ParticipantsTextBox"
                            Header="出演者"
                            Text="{x:Bind ViewModel.SelectedVideo.Participants, Mode=TwoWay}" />
                        <DatePicker
                            x:Name="ReleaseDatePicker"
                            Header="発売日"
                            Date="{x:Bind ViewModel.SelectedVideo.ReleaseDate, Mode=OneWay}"
                            DateChanged="ReleaseDatePicker_DateChanged" />
                        <TextBox
                            x:Name="CatalogNumberTextBox"
                            Header="品番"
                            Text="{x:Bind ViewModel.SelectedVideo.CatalogNumber, Mode=TwoWay}" />
                        <ComboBox
                            x:Name="RatingComboBox"
                            Header="評価"
                            HorizontalAlignment="Stretch"
                            SelectedIndex="{x:Bind ViewModel.SelectedVideo.RatingStarsIndex, Mode=TwoWay}">
                            <ComboBoxItem Content="☆☆☆☆☆ (未評価)" />
                            <ComboBoxItem Content="★☆☆☆☆ (1星)" />
                            <ComboBoxItem Content="★★☆☆☆ (2星)" />
                            <ComboBoxItem Content="★★★☆☆ (3星)" />
                            <ComboBoxItem Content="★★★★☆ (4星)" />
                            <ComboBoxItem Content="★★★★★ (5星)" />
                        </ComboBox>
                        <TextBox
                            x:Name="PublisherTextBox"
                            Header="発行元"
                            Text="{x:Bind ViewModel.SelectedVideo.Publisher, Mode=TwoWay}" />
                        <TextBox
                            x:Name="ContentDistributorTextBox"
                            Header="レーベル"
                            Text="{x:Bind ViewModel.SelectedVideo.ContentDistributor, Mode=TwoWay}" />
                        <TextBox
                            x:Name="CategoryTextBox"
                            Header="カテゴリ"
                            Text="{x:Bind ViewModel.SelectedVideo.Category, Mode=TwoWay}" />
                        <TextBox
                            x:Name="CommentTextBox"
                            Header="コメント"
                            Text="{x:Bind ViewModel.SelectedVideo.Comment, Mode=TwoWay}" />
                        <Button
                            x:Name="SaveMetadataButton"
                            HorizontalAlignment="Left"
                            Content="保存"
                            Click="OnSaveClicked"
                            IsEnabled="{x:Bind ViewModel.SelectedVideo.HasMetadataChangesNotify, Mode=OneWay}" />
                    </StackPanel>
                </ScrollViewer>

                <!-- Vertical GridSplitter between Properties Panel and Technical Properties Panel -->
                <controls:GridSplitter
                    Grid.Column="3"
                    Width="12"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Stretch"
                    ResizeBehavior="PreviousAndNext"
                    ResizeDirection="Columns"
                    Background="Transparent">
                    <controls:GridSplitter.Element>
                        <Grid HorizontalAlignment="Center" VerticalAlignment="Stretch" Width="2" Background="{ThemeResource CardStrokeColorDefaultBrush}" />
                    </controls:GridSplitter.Element>
                </controls:GridSplitter>

                <!-- Far Right Panel: Scrollable Non-Editable Technical Properties -->
                <ScrollViewer Grid.Column="4">
                    <StackPanel Spacing="12" Padding="0,0,12,0">
                        <TextBox
                            x:Name="DurationTextBox"
                            Header="再生時間"
                            IsReadOnly="True"
                            Text="{x:Bind ViewModel.SelectedVideo.Duration, Mode=OneWay}" />
                        <TextBox
                            x:Name="FrameWidthTextBox"
                            Header="フレーム幅"
                            IsReadOnly="True"
                            Text="{x:Bind ViewModel.SelectedVideo.FrameWidth, Mode=OneWay}" />
                        <TextBox
                            x:Name="FrameHeightTextBox"
                            Header="フレーム高さ"
                            IsReadOnly="True"
                            Text="{x:Bind ViewModel.SelectedVideo.FrameHeight, Mode=OneWay}" />
                        <TextBox
                            x:Name="FrameRateTextBox"
                            Header="フレームレート"
                            IsReadOnly="True"
                            Text="{x:Bind ViewModel.SelectedVideo.FrameRate, Mode=OneWay}" />
                        <TextBox
                            x:Name="VideoBitrateTextBox"
                            Header="映像ビットレート"
                            IsReadOnly="True"
                            Text="{x:Bind ViewModel.SelectedVideo.VideoBitrate, Mode=OneWay}" />
                        <TextBox
                            x:Name="VideoCompressionTextBox"
                            Header="圧縮方式"
                            IsReadOnly="True"
                            Text="{x:Bind ViewModel.SelectedVideo.VideoCompression, Mode=OneWay}" />
                        <TextBox
                            x:Name="AudioSampleRateTextBox"
                            Header="サンプルレート"
                            IsReadOnly="True"
                            Text="{x:Bind ViewModel.SelectedVideo.AudioSampleRate, Mode=OneWay}" />
                        <TextBox
                            x:Name="AudioBitrateTextBox"
                            Header="音声ビットレート"
                            IsReadOnly="True"
                            Text="{x:Bind ViewModel.SelectedVideo.AudioBitrate, Mode=OneWay}" />
                        <TextBox
                            x:Name="AudioFormatTextBox"
                            Header="音声形式"
                            IsReadOnly="True"
                            Text="{x:Bind ViewModel.SelectedVideo.AudioFormat, Mode=OneWay}" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Page>
